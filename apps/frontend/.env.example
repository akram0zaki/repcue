# RepCue Frontend Environment Variables
# Copy this file to .env.local for local development

# =============================================================================
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/<project-ref>/settings/api
# =============================================================================

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>

# =============================================================================
# App Base URL (for Universal Links / App Links - deep linking in native apps)
# This URL is used for magic link redirects in iOS/Android native apps
# =============================================================================
# Development: https://dev.repcue.me
# Production:  https://repcue.me
VITE_APP_BASE_URL=https://dev.repcue.me
